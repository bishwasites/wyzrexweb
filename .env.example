# Postgres connection string. For local dev, point this at a local Postgres
# (see docker-compose.yml) or a Neon/Vercel Postgres branch. In production,
# `vercel env pull` fills this in automatically from the linked project.
POSTGRES_URL=

# From the Vercel Blob store (Vercel dashboard → Storage → Blob → .env.local tab).
# Required for admin media uploads to work; everything else runs without it.
BLOB_READ_WRITE_TOKEN=

# Single admin account. Generate the hash with:
#   pnpm hash-password "your-password-here"
# The script escapes every `$` as `\$` automatically — paste its output
# as-is. (Next.js expands unescaped `$...` in .env files as variable
# references, which silently corrupts a raw bcrypt hash.)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random string used to sign the admin session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Contact-form lead notifications (Resend — https://resend.com/api-keys).
# Every submission is saved to the `leads` table regardless of whether these
# are set; without them the app just logs a warning and skips the emails.
RESEND_API_KEY=
# Inbox that receives the "new lead" notification.
LEAD_TO_EMAIL=
# Sender address for both the notification and the submitter's auto-reply.
# `onboarding@resend.dev` works out of the box with no setup — Resend owns
# it — but delivers with a "via resend.dev" label and can't be used for
# real production traffic. Once a sending domain is verified in the Resend
# dashboard (Domains → Add Domain, then the DNS records they give you),
# switch this to an address on that domain, e.g. "WYZREX <hello@wyzrex.com>".
LEAD_FROM_EMAIL=
